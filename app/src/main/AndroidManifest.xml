<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- rootfs 下载 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 读取当前网络的 DNS，用于安装后写入 guest 的 /etc/resolv.conf -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      共享存储（把 /sdcard 绑给 guest）。
      是否绑定由 StorageAccess.hasAccess() 决定（经 AppContainer.storageGranted 传入
      ProotManager）：没拿到**完整**（可写）访问时一个都不绑，guest 内不会出现一个
      半残的 /sdcard。
      本项目不考虑 Play 上架，因此直接申请「所有文件访问」以拿到完整可用的共享存储。

      分版本情况：
        · API ≤ 28（本机测试机 Android 9）：READ + WRITE_EXTERNAL_STORAGE 都要运行时授权。
          **只授 READ 会被系统挂成只读视图**（/storage/emulated 变成 gid=9997,mask=23），
          guest 内表现为"能 ls、一写就 Permission denied" —— 见 StorageAccess.hasAccess。
        · API 29：requestLegacyExternalStorage 生效，同上（WRITE 仍可授予）
        · API ≥ 30：需要 MANAGE_EXTERNAL_STORAGE，且必须引导用户去系统设置页开启
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 长时间运行的 Runtime（PRoot / Node / Pi Server）由前台服务承载 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SpikeApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.Spike">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Spike"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Runtime 生命周期承载（非业务逻辑中心，见方案 §25） -->
        <service
            android:name=".service.RuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local linux runtime host (proot) for spike" />
        </service>

    </application>

</manifest>
